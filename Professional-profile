<script>

const ACCOUNT_KEY = "luvio_doctor_accounts";
const CURRENT_KEY = "luvio_current_doctor";


function getAccounts(){

    return JSON.parse(
        localStorage.getItem(ACCOUNT_KEY) || "[]"
    );

}


function saveAccounts(accounts){

    localStorage.setItem(
        ACCOUNT_KEY,
        JSON.stringify(accounts)
    );

}


function getCurrentProfessional(){

    return JSON.parse(
        localStorage.getItem(CURRENT_KEY) || "null"
    );

}


function formatType(type){

    const types = {

        doctor:
            "Doctor",

        pharmacist:
            "Pharmacist",

        lab:
            "Laboratory Professional",

        nurse:
            "Nurse",

        other:
            "Other Healthcare Professional"

    };

    return types[type] ||
           "Healthcare Professional";

}


function showCorrectView(type){

    const sections = [
        "doctorView",
        "pharmacistView",
        "labView",
        "nurseView",
        "otherView"
    ];

    sections.forEach(id => {

        document
            .getElementById(id)
            .classList.add("hidden");

    });


    const selected =
        type === "doctor"
        ? "doctorView"
        : type === "pharmacist"
        ? "pharmacistView"
        : type === "lab"
        ? "labView"
        : type === "nurse"
        ? "nurseView"
        : "otherView";


    document
        .getElementById(selected)
        .classList.remove("hidden");

}


function loadProfile(){

    const p =
        getCurrentProfessional();


    if(!p){

        document.getElementById(
            "profileMessage"
        ).innerHTML = `
            <div class="error">
                No professional is currently logged in.
                Please log in through the Professional Portal.
            </div>
        `;

        return;

    }


    document.getElementById(
        "displayName"
    ).textContent =
        p.name || "Professional";


    document.getElementById(
        "displayId"
    ).textContent =
        p.id || "Professional ID";


    document.getElementById(
        "displayStatus"
    ).textContent =
        p.status || "Pending Verification";


    document.getElementById(
        "vType"
    ).textContent =
        formatType(p.type);


    document.getElementById(
        "vName"
    ).textContent =
        p.name || "—";


    document.getElementById(
        "vMobile"
    ).textContent =
        p.mobile || "—";


    document.getElementById(
        "vEmail"
    ).textContent =
        p.email || "—";


    document.getElementById(
        "vLanguages"
    ).textContent =
        p.languages || "—";


    document.getElementById(
        "vBio"
    ).textContent =
        p.bio || "—";


    showCorrectView(p.type);


    if(p.type === "doctor"){

        document.getElementById(
            "vDoctorQualification"
        ).textContent =
            p.qualification || "—";

        document.getElementById(
            "vDoctorSpecialization"
        ).textContent =
            p.specialization || "—";

        document.getElementById(
            "vDoctorRegistration"
        ).textContent =
            p.registration || "—";

        document.getElementById(
            "vDoctorAuthority"
        ).textContent =
            p.authority || "—";

        document.getElementById(
            "vDoctorExperience"
        ).textContent =
            p.experience
            ? p.experience + " years"
            : "—";

        document.getElementById(
            "vDoctorExpertise"
        ).textContent =
            p.expertise || "—";

        document.getElementById(
            "vDoctorMode"
        ).textContent =
            p.consultationMode || "—";

    }


    if(p.type === "pharmacist"){

        document.getElementById(
            "vPharmacistQualification"
        ).textContent =
            p.qualification || "—";

        document.getElementById(
            "vPharmacistRegistration"
        ).textContent =
            p.registration || "—";

        document.getElementById(
            "vPharmacistAuthority"
        ).textContent =
            p.authority || "—";

        document.getElementById(
            "vPharmacistExperience"
        ).textContent =
            p.experience
            ? p.experience + " years"
            : "—";

        document.getElementById(
            "vPharmacistExpertise"
        ).textContent =
            p.expertise || "—";

    }


    if(p.type === "lab"){

        document.getElementById(
            "vLabQualification"
        ).textContent =
            p.qualification || "—";

        document.getElementById(
            "vLabSpecialization"
        ).textContent =
            p.specialization || "—";

        document.getElementById(
            "vLabRegistration"
