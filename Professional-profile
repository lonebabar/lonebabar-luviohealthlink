function saveProfile(){

    const current =
        getCurrentProfessional();


    if(!current){

        return;

    }


    const name =
        document.getElementById(
            "pName"
        ).value.trim();


    const mobile =
        document.getElementById(
            "pMobile"
        ).value.trim();


    if(!name){

        document.getElementById(
            "editMessage"
        ).innerHTML = `
            <div class="error">
                Full Name is required.
            </div>
        `;

        return;

    }


    if(
        mobile &&
        !/^\d{10}$/.test(mobile)
    ){

        document.getElementById(
            "editMessage"
        ).innerHTML = `
            <div class="error">
                Enter a valid 10-digit mobile number.
            </div>
        `;

        return;

    }


    const type =
        document.getElementById(
            "pType"
        ).value;


    current.type = type;

    current.name = name;

    current.mobile = mobile;

    current.email =
        document.getElementById(
            "pEmail"
        ).value.trim();

    current.languages =
        document.getElementById(
            "pLanguages"
        ).value.trim();

    current.bio =
        document.getElementById(
            "pBio"
        ).value.trim();


    /*
    ================================================
    TYPE-SPECIFIC INFORMATION
    ================================================
    */


    if(type === "doctor"){

        current.qualification =
            document.getElementById(
                "pDoctorQualification"
            ).value.trim();

        current.specialization =
            document.getElementById(
                "pDoctorSpecialization"
            ).value.trim();

        current.registration =
            document.getElementById(
                "pDoctorRegistration"
            ).value.trim();

        current.authority =
            document.getElementById(
                "pDoctorAuthority"
            ).value.trim();

        current.experience =
            document.getElementById(
                "pDoctorExperience"
            ).value;

        current.expertise =
            document.getElementById(
                "pDoctorExpertise"
            ).value.trim();

        current.consultationMode =
            document.getElementById(
                "pDoctorMode"
            ).value;

    }


    if(type === "pharmacist"){

        current.qualification =
            document.getElementById(
                "pPharmacistQualification"
            ).value.trim();

        current.registration =
            document.getElementById(
                "pPharmacistRegistration"
            ).value.trim();

        current.authority =
            document.getElementById(
                "pPharmacistAuthority"
            ).value.trim();

        current.experience =
            document.getElementById(
                "pPharmacistExperience"
            ).value;

        current.expertise =
            document.getElementById(
                "pPharmacistExpertise"
            ).value.trim();

    }


    if(type === "lab"){

        current.qualification =
            document.getElementById(
                "pLabQualification"
            ).value.trim();

        current.specialization =
            document.getElementById(
                "pLabSpecialization"
            ).value.trim();

        current.registration =
            document.getElementById(
                "pLabRegistration"
            ).value.trim();

        current.authority =
            document.getElementById(
                "pLabAuthority"
            ).value.trim();

        current.experience =
            document.getElementById(
                "pLabExperience"
            ).value;

    }


    if(type === "nurse"){

        current.qualification =
            document.getElementById(
                "pNurseQualification"
            ).value.trim();

        current.specialization =
            document.getElementById(
                "pNurseSpecialization"
            ).value.trim();

        current.registration =
            document.getElementById(
                "pNurseRegistration"
            ).value.trim();

        current.authority =
            document.getElementById(
                "pNurseAuthority"
            ).value.trim();

        current.experience =
            document.getElementById(
                "pNurseExperience"
            ).value;

    }


    if(type === "other"){

        current.qualification =
            document.getElementById(
                "pOtherQualification"
            ).value.trim();

        current.specialization =
            document.getElementById(
                "pOtherSpecialization"
            ).value.trim();

        current.registration =
            document.getElementById(
                "pOtherRegistration"
            ).value.trim();

        current.authority =
            document.getElementById(
                "pOtherAuthority"
            ).value.trim();

        current.experience =
            document.getElementById(
                "pOtherExperience"
            ).value;

    }


    /*
    ================================================
    SAVE TO PROFESSIONAL ACCOUNTS
    ================================================
    */

    const accounts =
        getAccounts();


    const index =
        accounts.findIndex(
            x => x.id === current.id
        );


    if(index !== -1){

        accounts[index] = {
            ...accounts[index],
            ...current
        };

        saveAccounts(accounts);

    }


    /*
    ================================================
    SAVE CURRENT PROFESSIONAL
    ================================================
    */

    localStorage.setItem(
        CURRENT_KEY,
        JSON.stringify(current)
    );


    document.getElementById(
        "editMessage"
    ).innerHTML = `
        <div class="success">
            Professional profile updated successfully.
        </div>
    `;


    loadProfile();


    setTimeout(() => {

        cancelEdit();

    },800);

}


