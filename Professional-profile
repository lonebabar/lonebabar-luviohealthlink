<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f8fb;
    color:#18324a;
}

header{
    background:#0b6477;
    color:white;
    padding:18px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header a{
    color:white;
    text-decoration:none;
}

.wrap{
    max-width:1100px;
    margin:35px auto;
    padding:0 20px;
}

.card{
    background:white;
    padding:28px;
    border-radius:18px;
    box-shadow:0 8px 30px #0001;
    margin-bottom:22px;
}

.profile-header{
    display:flex;
    align-items:center;
    gap:22px;
    flex-wrap:wrap;
}

.profile-icon{
    width:100px;
    height:100px;
    border-radius:50%;
    background:#e9f1f5;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:45px;
}

.profile-name{
    margin:0 0 8px;
    font-size:28px;
}

.professional-id{
    color:#0b6477;
    font-weight:bold;
    font-size:17px;
}

.status{
    display:inline-block;
    margin-top:10px;
    padding:7px 12px;
    border-radius:20px;
    background:#edf7fa;
    color:#0b6477;
    font-size:14px;
    font-weight:bold;
}

.section-title{
    margin-top:0;
    color:#0b6477;
}

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.field{
    margin-bottom:4px;
}

.field label{
    display:block;
    font-weight:bold;
    margin-bottom:6px;
}

.field input,
.field select,
.field textarea{
    width:100%;
    padding:12px;
    border:1px solid #ccd8e1;
    border-radius:9px;
    font-family:inherit;
}

.field textarea{
    min-height:110px;
    resize:vertical;
}

.full{
    grid-column:1 / -1;
}

.actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:20px;
}

button,
.btn{
    border:0;
    border-radius:9px;
    padding:12px 18px;
    background:#0b6477;
    color:white;
    font-weight:bold;
    cursor:pointer;
    text-decoration:none;
    display:inline-block;
}

.secondary{
    background:#e9f1f5;
    color:#18324a;
}

.info-row{
    display:grid;
    grid-template-columns:230px 1fr;
    gap:15px;
    padding:12px 0;
    border-bottom:1px solid #edf0f2;
}

.info-label{
    font-weight:bold;
}

.notice{
    padding:14px;
    background:#edf7fa;
    border-radius:9px;
    margin-bottom:18px;
}

.error{
    padding:12px;
    background:#fff0f0;
    color:#a33;
    border-radius:9px;
    margin-bottom:15px;
}

.success{
    padding:12px;
    background:#eef9f0;
    color:#26733a;
    border-radius:9px;
    margin-bottom:15px;
}

.hidden{
    display:none;
}

.type-description{
    padding:14px;
    background:#f7fafc;
    border-left:4px solid #0b6477;
    border-radius:8px;
    margin-bottom:20px;
}

@media(max-width:700px){

    .grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .info-row{
        grid-template-columns:1fr;
        gap:5px;
    }

    header{
        flex-direction:column;
        align-items:flex-start;
        gap:12px;
    }
}
