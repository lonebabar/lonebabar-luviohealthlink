function hideAllFields(){

    document
        .querySelectorAll(
            ".doctorField,.pharmacistField,.labField,.nurseField,.otherField"
        )
        .forEach(el => {

            el.classList.add("hidden");

        });

}


function changeProfessionalType(){

    const type =
        document.getElementById(
            "pType"
        ).value;


    hideAllFields();


    const description =
        document.getElementById(
            "typeDescription"
        );


    if(type === "doctor"){

        document
            .querySelectorAll(".doctorField")
            .forEach(el =>
                el.classList.remove("hidden")
            );

        description.textContent =
            "Doctor profile: medical qualification, specialization, registration, experience and clinical professional information.";

    }


    else if(type === "pharmacist"){

        document
            .querySelectorAll(".pharmacistField")
            .forEach(el =>
                el.classList.remove("hidden")
            );

        description.textContent =
            "Pharmacist profile: pharmacy qualification, registration, professional experience and areas of practice.";

    }


    else if(type === "lab"){

        document
            .querySelectorAll(".labField")
            .forEach(el =>
                el.classList.remove("hidden")
            );

        description.textContent =
            "Laboratory professional profile: qualification, laboratory department/specialization, registration and experience.";

    }


    else if(type === "nurse"){

        document
            .querySelectorAll(".nurseField")
            .forEach(el =>
                el.classList.remove("hidden")
            );

        description.textContent =
            "Nursing profile: nursing qualification, specialization, registration and professional experience.";

